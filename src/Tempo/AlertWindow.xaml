<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tempo.AlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Border Background="{StaticResource PageBackgroundBrush}" Padding="24">
        <Grid RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <FontIcon Glyph="&#xEA8F;" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="KindText" Text="Reminder" Style="{StaticResource OverlineStyle}" />
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Top" />

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="SnoozeCombo" Grid.Column="0" VerticalAlignment="Center" MinWidth="130">
                    <ComboBoxItem Content="5 minutes" Tag="5" />
                    <ComboBoxItem Content="10 minutes" Tag="10" />
                    <ComboBoxItem Content="30 minutes" Tag="30" />
                    <ComboBoxItem Content="1 hour" Tag="60" />
                </ComboBox>
                <Button x:Name="SnoozeButton" Grid.Column="1" Content="Snooze" Padding="16,11" CornerRadius="10"
                        VerticalAlignment="Center" Click="OnSnooze" />
                <Button x:Name="DismissButton" Grid.Column="3" Content="Dismiss" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" MinWidth="120" Click="OnDismiss" />
            </Grid>
        </Grid>
    </Border>
</Window>
