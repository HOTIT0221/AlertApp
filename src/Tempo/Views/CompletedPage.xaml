<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tempo.Views.CompletedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tempo.ViewModels"
    Background="{StaticResource PageBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,32,40,40" HorizontalAlignment="Stretch" Spacing="24">
            <Grid Margin="4,0,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="Completed" Style="{StaticResource H1Style}" />
                    <TextBlock Text="A record of reminders that have run their course." Style="{StaticResource SubtitleStyle}" />
                </StackPanel>
                <Button x:Name="ClearAllButton" Content="Clear all" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Padding="14,10" CornerRadius="10" Click="OnClearAll" />
            </Grid>

            <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Visibility="Collapsed" Padding="36">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoftBrush}">
                        <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="Nothing completed yet" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="One-time reminders and finished routines will collect here." FontSize="13"
                               Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="320" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertListItemViewModel">
                        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                                        Background="#EEF7EF" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="#3AA76D" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Message}" Visibility="{x:Bind MessageVisibility}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind NextText}" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                    <Button Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8"
                                            Click="OnReactivate" Tag="{x:Bind Id}" ToolTipService.ToolTip="Reactivate"
                                            AutomationProperties.Name="Reactivate alert">
                                        <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8"
                                            Click="OnDelete" Tag="{x:Bind Id}" ToolTipService.ToolTip="Delete"
                                            AutomationProperties.Name="Delete alert">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
