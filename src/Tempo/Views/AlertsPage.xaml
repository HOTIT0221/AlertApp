<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tempo.Views.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Tempo.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PageBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="40,32,40,40" MaxWidth="1480" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="4,0,0,28">
                <TextBlock Text="A little more present." Style="{StaticResource H1Style}" />
                <TextBlock Text="Set it. Forget it. Be there when it matters." Style="{StaticResource SubtitleStyle}" />
            </StackPanel>

            <!-- Two columns -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Col0" Width="1*" />
                    <ColumnDefinition x:Name="Col1" Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Create form ===== -->
                <Border x:Name="FormCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}"
                        Margin="0,0,16,0" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel Spacing="18">
                        <TextBlock x:Name="FormTitle" Text="Create an alert" Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel x:Name="TimeField" Spacing="6">
                            <TextBlock Text="Time" Style="{StaticResource FieldLabelStyle}" />
                            <TimePicker x:Name="TimeInput" MinuteIncrement="1" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Reminder title" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TitleInput" Style="{StaticResource TempoTextBoxStyle}"
                                     PlaceholderText="e.g. A moment for yourself" MaxLength="120"
                                     TextChanged="OnFormChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Details (optional)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="DetailsInput" Style="{StaticResource TempoTextBoxStyle}"
                                     PlaceholderText="e.g. Take a few minutes to breathe, stretch, or check in with how you're feeling."
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="86" MaxLength="500" />
                        </StackPanel>

                        <!-- Routine -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="MAKE IT A ROUTINE" Style="{StaticResource OverlineStyle}" />
                            <Border Background="#F4F5F8" CornerRadius="10" Padding="4">
                                <Grid x:Name="SegmentContainer">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="SegOnce" Style="{StaticResource SegmentButtonStyle}"
                                            Content="Once" Tag="Once" Click="OnSegmentClick" />
                                    <Button Grid.Column="1" x:Name="SegDaily" Style="{StaticResource SegmentButtonStyle}"
                                            Content="Daily" Tag="Daily" Click="OnSegmentClick" />
                                    <Button Grid.Column="2" x:Name="SegWeekly" Style="{StaticResource SegmentButtonStyle}"
                                            Content="Weekly" Tag="Weekly" Click="OnSegmentClick" />
                                    <Button Grid.Column="3" x:Name="SegCustom" Style="{StaticResource SegmentButtonStyle}"
                                            Content="Custom" Tag="Custom" Click="OnSegmentClick" />
                                </Grid>
                            </Border>

                            <!-- Once: date -->
                            <StackPanel x:Name="OncePanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" />
                                <CalendarDatePicker x:Name="OnceDateInput" HorizontalAlignment="Stretch"
                                                    PlaceholderText="Pick a date" />
                            </StackPanel>

                            <!-- Weekly: day pills -->
                            <StackPanel x:Name="WeeklyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <ToggleButton x:Name="DaySun" Style="{StaticResource DayToggleStyle}" Content="Sun" Checked="OnDayToggled" Unchecked="OnDayToggled" />
                                <ToggleButton x:Name="DayMon" Style="{StaticResource DayToggleStyle}" Content="Mon" Checked="OnDayToggled" Unchecked="OnDayToggled" />
                                <ToggleButton x:Name="DayTue" Style="{StaticResource DayToggleStyle}" Content="Tue" Checked="OnDayToggled" Unchecked="OnDayToggled" />
                                <ToggleButton x:Name="DayWed" Style="{StaticResource DayToggleStyle}" Content="Wed" Checked="OnDayToggled" Unchecked="OnDayToggled" />
                                <ToggleButton x:Name="DayThu" Style="{StaticResource DayToggleStyle}" Content="Thu" Checked="OnDayToggled" Unchecked="OnDayToggled" />
                                <ToggleButton x:Name="DayFri" Style="{StaticResource DayToggleStyle}" Content="Fri" Checked="OnDayToggled" Unchecked="OnDayToggled" />
                                <ToggleButton x:Name="DaySat" Style="{StaticResource DayToggleStyle}" Content="Sat" Checked="OnDayToggled" Unchecked="OnDayToggled" />
                            </StackPanel>

                            <!-- Custom: interval -->
                            <StackPanel x:Name="CustomPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="Repeat every" Style="{StaticResource FieldLabelStyle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.3*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:NumberBox x:Name="IntervalCountInput" Grid.Column="0" Value="2"
                                                        Minimum="1" Maximum="9999" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Name="IntervalUnitInput" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="1">
                                        <ComboBoxItem Content="Minutes" />
                                        <ComboBoxItem Content="Hours" />
                                        <ComboBoxItem Content="Days" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <!-- Ends (limit) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Ends" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="EndsInput" HorizontalAlignment="Stretch" SelectedIndex="0"
                                          SelectionChanged="OnEndsChanged">
                                    <ComboBoxItem Content="Never" />
                                    <ComboBoxItem Content="On date" />
                                    <ComboBoxItem Content="After a number of times" />
                                </ComboBox>
                                <CalendarDatePicker x:Name="EndDateInput" HorizontalAlignment="Stretch"
                                                    PlaceholderText="End date" Visibility="Collapsed" Margin="0,4,0,0" />
                                <controls:NumberBox x:Name="EndCountInput" Minimum="1" Maximum="100000" Value="5"
                                                    SpinButtonPlacementMode="Compact" Visibility="Collapsed" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Sound -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE767;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel>
                                    <TextBlock Text="Gentle sound" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="A calm, subtle alert sound" FontSize="12"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch x:Name="SoundInput" IsOn="True" OnContent="" OffContent=""
                                          HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Validation -->
                        <controls:InfoBar x:Name="FormError" Severity="Error" IsOpen="False" IsClosable="False" />

                        <!-- Actions -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveButton" Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Create alert" Click="OnSaveClick" />
                            <Button x:Name="CancelEditButton" Grid.Column="1" Content="Cancel" Padding="16,12"
                                    CornerRadius="10" Visibility="Collapsed" Click="OnCancelEditClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Saved alerts ===== -->
                <StackPanel x:Name="ListColumn" Grid.Column="1" Grid.Row="0" Margin="14,0,0,0" Spacing="14">
                    <Grid>
                        <TextBlock Text="Your alerts" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border Background="#F4F5F8" CornerRadius="9" Padding="3" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FilterAll" Style="{StaticResource SegmentButtonStyle}" Content="All"
                                        Tag="All" MinWidth="64" Click="OnFilterClick" />
                                <Button x:Name="FilterActive" Style="{StaticResource SegmentButtonStyle}" Content="Active"
                                        Tag="Active" MinWidth="64" Click="OnFilterClick" />
                                <Button x:Name="FilterPaused" Style="{StaticResource SegmentButtonStyle}" Content="Paused"
                                        Tag="Paused" MinWidth="64" Click="OnFilterClick" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Undo bar -->
                    <controls:InfoBar x:Name="UndoBar" Severity="Informational" IsOpen="False" IsClosable="True"
                                      Title="Alert deleted" Message="">
                        <controls:InfoBar.ActionButton>
                            <Button Content="Undo" Click="OnUndoClick" />
                        </controls:InfoBar.ActionButton>
                    </controls:InfoBar>

                    <!-- Empty state -->
                    <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Visibility="Collapsed" Padding="32">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoftBrush}">
                                <FontIcon Glyph="&#xEA8F;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="No alerts yet" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Create your first reminder on the left. Tempo will be there right on time."
                                       FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" />
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <ItemsControl x:Name="AlertsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlertListItemViewModel">
                                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                                Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind TimeText}" FontSize="17" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Message}" Visibility="{x:Bind MessageVisibility}"
                                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                                                        Padding="10,5" HorizontalAlignment="Left"
                                                        Visibility="{x:Bind ScheduleVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBlock Text="{x:Bind ScheduleText}" FontSize="12.5"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{x:Bind NextText}" FontSize="12"
                                                           Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                            <ToggleSwitch IsOn="{x:Bind IsEnabled}" OnContent="" OffContent="" MinWidth="0"
                                                          Toggled="OnItemToggled" Tag="{x:Bind Id}"
                                                          AutomationProperties.Name="Enable alert" />
                                            <Button Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8"
                                                    Click="OnEditClick" Tag="{x:Bind Id}" ToolTipService.ToolTip="Edit"
                                                    AutomationProperties.Name="Edit alert">
                                                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="8"
                                                    Click="OnDeleteClick" Tag="{x:Bind Id}" ToolTipService.ToolTip="Delete"
                                                    AutomationProperties.Name="Delete alert">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Encouragement -->
                    <Border CornerRadius="14" Background="{StaticResource AccentSoftBrush}" Padding="18">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xEB51;" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Keep showing up for yourself." FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Small reminders can make a big difference over time." FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="Col1.Width" Value="0" />
                            <Setter Target="Col0.Width" Value="*" />
                            <Setter Target="FormCard.MaxWidth" Value="99999" />
                            <Setter Target="FormCard.(Grid.Row)" Value="0" />
                            <Setter Target="FormCard.Margin" Value="0,0,0,0" />
                            <Setter Target="ListColumn.(Grid.Column)" Value="0" />
                            <Setter Target="ListColumn.(Grid.Row)" Value="1" />
                            <Setter Target="ListColumn.Margin" Value="0,24,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ScrollViewer>
</Page>
