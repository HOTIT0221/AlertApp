<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tempo.Views.UpcomingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tempo.ViewModels"
    Background="{StaticResource PageBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,32,40,40" MaxWidth="900" HorizontalAlignment="Left" Spacing="24">
            <StackPanel Spacing="6" Margin="4,0,0,0">
                <TextBlock Text="Upcoming" Style="{StaticResource H1Style}" />
                <TextBlock Text="Everything ahead, sorted by what happens next." Style="{StaticResource SubtitleStyle}" />
            </StackPanel>

            <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Visibility="Collapsed" Padding="36">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoftBrush}">
                        <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="Nothing scheduled" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="When you have active reminders, the next ones show up here." FontSize="13"
                               Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="320" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertListItemViewModel">
                        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind NextText}" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Message}" Visibility="{x:Bind MessageVisibility}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10,5"
                                            HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ScheduleText}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled}" OnContent="" OffContent=""
                                              MinWidth="0" Toggled="OnItemToggled" Tag="{x:Bind Id}"
                                              VerticalAlignment="Top" AutomationProperties.Name="Enable alert" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
