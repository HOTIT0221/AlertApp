<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tempo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tempo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border x:Name="Sidebar" Grid.Column="0" Width="248"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="8,4,0,28">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                        <Viewbox Width="22" Height="22">
                            <Grid Width="24" Height="24">
                                <Ellipse Width="20" Height="20" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12 7 L12 12 L15.5 14" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="tempo." FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" x:Name="NavPanel" Spacing="4">
                    <Button x:Name="NavAlerts" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="Alerts"
                            AutomationProperties.Name="My alerts">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon x:Name="NavAlertsIcon" Glyph="&#xEA8F;" FontSize="18" />
                            <TextBlock Text="My alerts" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavUpcoming" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="Upcoming"
                            AutomationProperties.Name="Upcoming">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon x:Name="NavUpcomingIcon" Glyph="&#xE787;" FontSize="18" />
                            <TextBlock Text="Upcoming" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavCompleted" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="Completed"
                            AutomationProperties.Name="Completed">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon x:Name="NavCompletedIcon" Glyph="&#xE73E;" FontSize="18" />
                            <TextBlock Text="Completed" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Click="OnNavClick" Tag="Settings"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon x:Name="NavSettingsIcon" Glyph="&#xE713;" FontSize="18" />
                            <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer / workspace -->
                <Border Grid.Row="2" CornerRadius="10" Padding="10,8" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="A" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Personal" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="My workspace" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <Frame x:Name="ContentFrame" Grid.Column="1" />
    </Grid>
</Window>
